{
  "manifest_version": 3,
  "name": "Türkçe Toplantı Asistanı",
  "version": "1.0.0",
  "description": "Google Meet toplantılarında gerçek zamanlı Türkçe transkripsiyon ve not alma",

  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://meet.google.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Toplantı Asistanı"
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
